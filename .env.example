# Базовые настройки
# (название панели задаётся в админке: Admin → Настройки → panel_name в БД)

# NextAuth
NEXTAUTH_SECRET="сгенерируй: openssl rand -base64 32"
NUXTAUTH_URL="http://localhost:3000"
AUTH_ORIGIN="http://localhost:3000/api/auth"

# Discord / GitHub / Google — только для ПЕРВОГО запуска: значения
# один раз переезжают в БД (шифрованно) и дальше рулятся из админки
# (Admin → Настройки → Способы входа). Можно оставить пустыми —
# тогда все OAuth-кнопки выключены, остаётся вход по почте+паролю.
DISCORD_CLIENT_ID="твой_client_id"
DISCORD_CLIENT_SECRET="твой_client_secret"

GITHUB_CLIENT_ID="твой_client_id"
GITHUB_CLIENT_SECRET="твой_client_secret"

GOOGLE_CLIENT_ID="твой_client_id"
GOOGLE_CLIENT_SECRET="твой_client_secret"

# ============ База данных панели ============
# По умолчанию — локальный файл SQLite, ничего ставить не надо:
# панель сама создаст ./data/panel.sqlite при первом запуске
# (после `npm run db:migrate`, см. README).
DB_DIALECT="sqlite"
SQLITE_PATH="./data/panel.sqlite"

# --- Серверная MySQL (раскомментируй для переезда на серверную БД) ---
# DB_DIALECT="mysql"
# DB_HOST="localhost"
# DB_PORT="3306"
# DB_USER="kt-user"
# DB_PASSWORD="Password123"
# DB_NAME="ktpanel"
# DATABASE_URL="mysql://kt-user@localhost:3306/ktpanel"

# Публичный URL САМОЙ ПАНЕЛИ — wings-ноды зовут сюда колбэки бэкапов
# (POST /api/remote/backups/{uuid}) и проверки SFTP (POST /api/remote/sftp/auth).
# Пушится в каждую ноду автоматически при создании/обновлении
# (Admin → Nodes) через POST {node}/v1/config.
NUXT_PANEL_URL="http://localhost:3000"

DEBUG='true'
